<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.lang.String?>
<?import java.net.URL?>

<VBox xmlns:fx="http://javafx.com/fxml/1" maxHeight="448.0" maxWidth="250.0" minWidth="250.0" prefWidth="250.0"
      styleClass="box" xmlns="http://javafx.com/javafx/17.0.12"
      fx:controller="seda_project.control_alt_defeat.gamebox.ui.EasterEgg">
    <stylesheets>
        <URL value="@../css/stylesheets/MenuStyle.css"/>
        <URL value="@../css/stylesheets/fontstyle.css"/>
        <URL value="@../css/stylesheets/MainTheme.css"/>
    </stylesheets>
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
    </padding>
    <Label styleClass="normalText" text="You found the EasterEgg Section!" textAlignment="CENTER" wrapText="true"/>
    <Label text="Like in Minecraft you can change the appearance of some views by using different names. No clue which name does what? Maybe this can help you:"
           wrapText="true">
        <VBox.margin>
            <Insets top="10.0"/>
        </VBox.margin>
    </Label>
    <VBox fx:id="spoilerBox" maxHeight="-Infinity" maxWidth="-Infinity" onMouseClicked="#onSpoilerClickAction">
        <styleClass>
            <String fx:value="spoilerBox"/>
            <String fx:value="box"/>
        </styleClass>
        <VBox.margin>
            <Insets/>
        </VBox.margin>
        <padding>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
        </padding>
        <Label styleClass="hiddenText" text="&gt; jeb_"/>
        <Label styleClass="hiddenText" text="&gt; Dinnerbone"/>
        <Label styleClass="hiddenText" text="&gt; Grumm"/>
        <Label styleClass="hiddenText" text="&gt; Duck"/>
    </VBox>
    <Label text="Further it might be interesting to double click different elements. the appearance might change"
           wrapText="true">
        <VBox.margin>
            <Insets top="10.0"/>
        </VBox.margin>
    </Label>
    <Label text="As in many other Games we also included something regarding the konami-Code." wrapText="true">
        <padding>
            <Insets top="10.0"/>
        </padding>
    </Label>
</VBox>
