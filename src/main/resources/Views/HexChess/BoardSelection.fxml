<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import seda_project.control_alt_defeat.gamebox.ui.HexButton?>
<?import seda_project.control_alt_defeat.gamebox.ui.HexVBox?>

<StackPane fx:id="root" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="600.0" minWidth="800.0" styleClass="background" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="seda_project.control_alt_defeat.gamebox.HexChess.Controller.BoardSelection">
    <stylesheets>
        <URL value="@../../css/stylesheets/fontstyle.css" />
        <URL value="@../../css/stylesheets/MainTheme.css" />
        <URL value="@../../css/stylesheets/MenuStyle.css" />
        <URL value="@../../css/stylesheets/HexChessMenu.css" />
    </stylesheets>
    <VBox alignment="TOP_CENTER">
        <fx:include source="../TopBar.fxml" />
      <HexVBox fx:id="header" alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="box">
         <children>
                   <Label alignment="CENTER" contentDisplay="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="headerText" text="Hex Chess" textAlignment="CENTER" textOverrun="CLIP">
                       <font>
                           <Font name="Arial Bold" size="24.0" />
                       </font>
                   </Label>
                   <Label alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="normalText" text="Board Selection">
                       <font>
                           <Font size="18.0" />
                       </font>
                   </Label>
         </children>
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin>
      </HexVBox>

        <StackPane prefHeight="465.0" VBox.vgrow="ALWAYS">
         <HexVBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="box">
            <children>
                   <ScrollPane fx:id="scrollPane" hbarPolicy="NEVER" maxHeight="300.0" maxWidth="-Infinity" styleClass="scroller" vbarPolicy="ALWAYS">
                       <padding>
                           <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                       </padding>
                       <VBox fx:id="scrollContent" alignment="CENTER_LEFT" maxHeight="300.0" maxWidth="-Infinity" />
                   </ScrollPane>
                   <HBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity">
                       <StackPane maxHeight="-Infinity" maxWidth="-Infinity" styleClass="button-wrapper">
                     <HexButton onAction="#onBackAction" text="Cancel" />
                       </StackPane>
                       <StackPane maxHeight="-Infinity" maxWidth="-Infinity" styleClass="button-wrapper">
                     <HexButton onAction="#onUseAction" text="Use" />
                       </StackPane>
                       <StackPane layoutX="101.0" layoutY="10.0" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="button-wrapper">
                     <HexButton onAction="#onDeleteAction" text="Delete" />
                       </StackPane>
                   </HBox>
            </children>
         </HexVBox>
        </StackPane>
    </VBox>
</StackPane>
