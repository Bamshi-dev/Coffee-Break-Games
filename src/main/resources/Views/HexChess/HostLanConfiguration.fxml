<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import seda_project.control_alt_defeat.gamebox.ui.HexButton?>
<?import seda_project.control_alt_defeat.gamebox.ui.HexLabel?>
<?import seda_project.control_alt_defeat.gamebox.ui.HexVBox?>

<StackPane fx:id="root" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="600.0" minWidth="800.0" styleClass="background" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="seda_project.control_alt_defeat.gamebox.HexChess.Controller.HostLanConfiguration">
    <VBox alignment="TOP_CENTER">
        <fx:include source="../TopBar.fxml" />
      <HexVBox fx:id="header" alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="box">
         <children>
                   <Label alignment="CENTER" contentDisplay="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="headerText" text="Hex Chess" textAlignment="CENTER" textOverrun="CLIP">
                       <font>
                           <Font name="Arial Bold" size="24.0" />
                       </font>
                   </Label>
                   <Label alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="normalText" text="Host Configuration">
                       <font>
                           <Font size="18.0" />
                       </font>
                   </Label>
         </children>
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin>
      </HexVBox>

        <StackPane prefHeight="485.0" VBox.vgrow="ALWAYS">
         <HexVBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="box">
            <children>
                   <HBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity">
                       <Label alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" text="Your Name:" />
                       <TextField fx:id="hostNameTF" maxHeight="-Infinity" maxWidth="-Infinity" promptText="Insert Player 1 Name " />
                   </HBox>
                   <StackPane maxHeight="-Infinity" maxWidth="-Infinity" styleClass="button-wrapper">
                  <HexButton onAction="#onCustomBoardAction" text="Use Custom Board" />
                   </StackPane>
               <HexLabel fx:id="statusLabel" maxWidth="250.0" styleClass="error" visible="false" wrapText="true" />
                   <HBox maxHeight="-Infinity" maxWidth="-Infinity">
                       <StackPane alignment="CENTER_RIGHT" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="button-wrapper">
                     <HexButton onAction="#onBackAction" text="Back" />
                       </StackPane>
                       <StackPane alignment="CENTER_LEFT" styleClass="button-wrapper" GridPane.columnIndex="1" GridPane.rowIndex="2">
                     <HexButton onAction="#onSearchAction" text="Search" />
                       </StackPane>
                   </HBox>
            </children>
         </HexVBox>
        </StackPane>
    </VBox>
    <stylesheets>
        <URL value="@../../css/stylesheets/fontstyle.css" />
        <URL value="@../../css/stylesheets/MainTheme.css" />
        <URL value="@../../css/stylesheets/MenuStyle.css" />
        <URL value="@../../css/stylesheets/HexChessMenu.css" />
    </stylesheets>
</StackPane>
