<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import seda_project.control_alt_defeat.gamebox.ui.HexButton?>
<?import seda_project.control_alt_defeat.gamebox.ui.HexLabel?>
<?import seda_project.control_alt_defeat.gamebox.ui.HexVBox?>

<StackPane fx:id="root" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="600.0" minWidth="800.0" styleClass="background" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="seda_project.control_alt_defeat.gamebox.HexChess.Controller.JoinLan">
    <VBox alignment="TOP_CENTER">
        <fx:include source="../TopBar.fxml" />
        <HexVBox fx:id="header" alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="box">
            <VBox.margin>
                <Insets top="10.0" />
            </VBox.margin>
            <Label alignment="CENTER" contentDisplay="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="headerText" text="Hex Chess" textAlignment="CENTER" textOverrun="CLIP">
                <font>
                    <Font name="Arial Bold" size="24.0" />
                </font>
            </Label>
            <Label alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="normalText" text="Join a Game">
                <font>
                    <Font size="18.0" />
                </font>
            </Label>
        </HexVBox>

        <StackPane prefHeight="465.0" VBox.vgrow="ALWAYS">
            <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" spacing="5.0" styleClass="box">
                <HBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity">
                    <Label alignment="CENTER" text="Your Name:">
                        <HBox.margin>
                            <Insets right="10.0" />
                        </HBox.margin>
                    </Label>
                    <TextField fx:id="joinPlayerNameTF" promptText="Insert Player 1 Name " />
                </HBox>
                <ScrollPane fx:id="scrollPane" fitToWidth="true" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="scroller">
                    <VBox fx:id="scrollElements" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="transparent-scroll-content" />
                </ScrollPane>
                <Label styleClass="normalText" text="Ports 8766 and 8765 have to be open" />
                <HexLabel fx:id="joinStatus" maxWidth="270.0" styleClass="error" visible="false" wrapText="true" />
                <HBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity">
                    <StackPane styleClass="button-wrapper">
                        <HexButton onAction="#onBackAction" text="Back" />
                    </StackPane>
                    <StackPane styleClass="button-wrapper">
                        <HexButton onAction="#onConnectAction" text="Connect" />
                    </StackPane>
                </HBox>
            <padding>
               <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            </VBox>
            <padding>
                <Insets top="5.0" />
            </padding>
        </StackPane>
    </VBox>

    <stylesheets>
        <URL value="@../../css/stylesheets/fontstyle.css" />
        <URL value="@../../css/stylesheets/MainTheme.css" />
        <URL value="@../../css/stylesheets/MenuStyle.css" />
        <URL value="@../../css/stylesheets/HexChessMenu.css" />
    </stylesheets>
</StackPane>
