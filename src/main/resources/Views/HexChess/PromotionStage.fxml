<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import seda_project.control_alt_defeat.gamebox.ui.HexButton?>
<?import seda_project.control_alt_defeat.gamebox.ui.HexVBox?>
<?import java.net.URL?>
<StackPane xmlns:fx="http://javafx.com/fxml/1" fx:id="root" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity"
           minWidth="-Infinity" styleClass="playground" xmlns="http://javafx.com/javafx/26"
           fx:controller="seda_project.control_alt_defeat.gamebox.HexChess.Controller.Promotion">

    <stylesheets>
        <URL value="@../../css/stylesheets/fontstyle.css"/>
        <URL value="@../../css/stylesheets/MainTheme.css"/>
        <URL value="@../../css/stylesheets/MenuStyle.css"/>
        <URL value="@../../css/stylesheets/HexChessMenu.css"/>
    </stylesheets>
    <HexVBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="box">
        <Label styleClass="normalText" text="Select the Piece"/>
        <HBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" spacing="10.0">
            <ImageView fx:id="RookImgView" fitHeight="50.0" fitWidth="50.0" onMouseClicked="#onPieceClickedAction"
                       pickOnBounds="true" preserveRatio="true"/>
            <ImageView fx:id="KnightImgView" fitHeight="50.0" fitWidth="50.0" onMouseClicked="#onPieceClickedAction"
                       pickOnBounds="true" preserveRatio="true"/>
            <ImageView fx:id="BishopImgView" fitHeight="50.0" fitWidth="50.0" onMouseClicked="#onPieceClickedAction"
                       pickOnBounds="true" preserveRatio="true"/>
            <ImageView fx:id="QueenImgView" fitHeight="50.0" fitWidth="50.0" onMouseClicked="#onPieceClickedAction"
                       pickOnBounds="true" preserveRatio="true"/>
        </HBox>
        <HBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity">
            <StackPane maxHeight="-Infinity" maxWidth="-Infinity" styleClass="button-wrapper">
                <HexButton onAction="#onPromoteAction" text="Promote"/>
            </StackPane>
        </HBox>
    </HexVBox>
</StackPane>
