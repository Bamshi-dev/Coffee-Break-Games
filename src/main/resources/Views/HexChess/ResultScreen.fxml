<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import seda_project.control_alt_defeat.gamebox.ui.HexButton?>
<?import seda_project.control_alt_defeat.gamebox.ui.HexLabel?>

<StackPane fx:id="root" maxHeight="-Infinity" maxWidth="-Infinity" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="seda_project.control_alt_defeat.gamebox.HexChess.Controller.ResultScreen">
      <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" spacing="5.0" styleClass="box">
          <HBox maxHeight="-Infinity" maxWidth="-Infinity">
              <Label maxHeight="-Infinity" maxWidth="-Infinity" styleClass="normalText" text="Game Result: " />
              <Label fx:id="resultLabel" styleClass="normalText" />
          </HBox>
          <GridPane hgap="10.0" maxHeight="-Infinity" maxWidth="-Infinity" vgap="4.0">
              <columnConstraints>
                  <ColumnConstraints hgrow="SOMETIMES" maxWidth="-Infinity" />
                  <ColumnConstraints hgrow="SOMETIMES" maxWidth="-Infinity" />
                  <ColumnConstraints hgrow="SOMETIMES" maxWidth="-Infinity" />
              </columnConstraints>
              <rowConstraints>
                  <RowConstraints maxHeight="-Infinity" vgrow="SOMETIMES" />
                  <RowConstraints maxHeight="-Infinity" vgrow="SOMETIMES" />
            <RowConstraints maxHeight="-Infinity" vgrow="SOMETIMES" />
              </rowConstraints>
              <Label fx:id="p1NameLabel" maxHeight="-Infinity" maxWidth="-Infinity" text="Label" />
              <Label fx:id="p2NameLabel" maxHeight="-Infinity" maxWidth="-Infinity" text="Label" GridPane.rowIndex="2" />
              <Label fx:id="p1Score" text="0.0" GridPane.columnIndex="1" />
              <Label fx:id="p2Score" text="0.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
              <Label fx:id="p1Awarded" text="0.0" GridPane.columnIndex="2" />
              <Label fx:id="p2Awarded" text="0.0" GridPane.columnIndex="2" GridPane.rowIndex="2" />
          </GridPane>
      <HexLabel fx:id="statusLabel" maxWidth="200.0" styleClass="information" textAlignment="CENTER" visible="false" wrapText="true" />
          <HBox alignment="CENTER">
              <StackPane alignment="CENTER_LEFT" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="button-wrapper">
                  <HexButton onAction="#onExitAction" text="Exit" />
              </StackPane>
              <StackPane alignment="CENTER_LEFT" layoutX="10.0" layoutY="10.0" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="button-wrapper">
                  <HexButton onAction="#onPlayAgainAction" text="Play Again" />
              </StackPane>
          </HBox>
      <padding>
         <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
      </padding>
      </VBox>

    <stylesheets>
        <URL value="@../../css/stylesheets/fontstyle.css" />
        <URL value="@../../css/stylesheets/MainTheme.css" />
        <URL value="@../../css/stylesheets/MenuStyle.css" />
        <URL value="@../../css/stylesheets/HexChessMenu.css" />
    </stylesheets>
</StackPane>
