<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import seda_project.control_alt_defeat.gamebox.ui.HexButton?>
<?import seda_project.control_alt_defeat.gamebox.ui.HexLabel?>
<?import seda_project.control_alt_defeat.gamebox.ui.HexVBox?>

<StackPane fx:id="root" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="600.0" minWidth="800.0" styleClass="background" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="seda_project.control_alt_defeat.gamebox.HexChess.Controller.WaitForOpponent">
    <VBox alignment="TOP_CENTER">
        <fx:include source="../TopBar.fxml" />
      <HexVBox fx:id="header" alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="box">
         <children>
                   <Label alignment="CENTER" contentDisplay="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="headerText" text="Hex Chess" textAlignment="CENTER" textOverrun="CLIP">
                       <font>
                           <Font name="Arial Bold" size="24.0" />
                       </font>
                   </Label>
                   <Label alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="normalText" text="Lobby">
                       <font>
                           <Font size="18.0" />
                       </font>
                   </Label>
         </children>
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin>
      </HexVBox>

        <StackPane prefHeight="465.0" VBox.vgrow="ALWAYS">
         <HexVBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="box">
            <children>
                   <GridPane alignment="CENTER" hgap="5.0" maxHeight="-Infinity" maxWidth="-Infinity" vgap="5.0">
                       <columnConstraints>
                           <ColumnConstraints halignment="LEFT" hgrow="SOMETIMES" maxWidth="-Infinity" />
                           <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" maxWidth="-Infinity" />
                       </columnConstraints>
                       <rowConstraints>
                           <RowConstraints maxHeight="-Infinity" vgrow="SOMETIMES" />
                           <RowConstraints maxHeight="-Infinity" vgrow="SOMETIMES" />
                           <RowConstraints maxHeight="-Infinity" vgrow="SOMETIMES" />
                           <RowConstraints maxHeight="-Infinity" valignment="CENTER" vgrow="ALWAYS" />
                       </rowConstraints>
                       <Label alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" text="Your Name:" />
                       <Label fx:id="yourNameLabel" alignment="CENTER" contentDisplay="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" textAlignment="CENTER" GridPane.columnIndex="1" />
                       <Label maxHeight="-Infinity" maxWidth="-Infinity" text="Stauts" GridPane.rowIndex="3" />
                  <HexLabel fx:id="statusLabel" maxWidth="140.0" styleClass="information" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                       <Label maxHeight="-Infinity" maxWidth="-Infinity" text="Opponent Name" GridPane.rowIndex="2" />
                       <Label fx:id="opponentNameLabel" alignment="CENTER" contentDisplay="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" textAlignment="CENTER" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                       <Label maxHeight="-Infinity" maxWidth="-Infinity" text="Host IP-Address:" GridPane.rowIndex="1" />
                       <Label fx:id="hostIpAddressLabel" alignment="CENTER" contentDisplay="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" textAlignment="CENTER" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                   </GridPane>
                   <HBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" spacing="10.0">
                       <StackPane styleClass="button-wrapper">
                     <HexButton onAction="#onBackAction" text="Cancel" />
                       </StackPane>
                       <StackPane styleClass="button-wrapper">
                     <HexButton fx:id="startButton" onAction="#onStartGameAction" text="Start Game" />
                       </StackPane>
                       <opaqueInsets>
                           <Insets />
                       </opaqueInsets>
                   </HBox>
            </children>
         </HexVBox>
        </StackPane>
    </VBox>

    <stylesheets>
        <URL value="@../../css/stylesheets/fontstyle.css" />
        <URL value="@../../css/stylesheets/MainTheme.css" />
        <URL value="@../../css/stylesheets/MenuStyle.css" />
        <URL value="@../../css/stylesheets/HexChessMenu.css" />
    </stylesheets>
</StackPane>
