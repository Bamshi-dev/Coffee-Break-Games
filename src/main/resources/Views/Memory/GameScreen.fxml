<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import seda_project.control_alt_defeat.gamebox.ui.*?>
<?import java.lang.String?>
<?import java.net.URL?>

<StackPane xmlns:fx="http://javafx.com/fxml/1" fx:id="root" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="600.0"
           minWidth="800.0" styleClass="playground" xmlns="http://javafx.com/javafx/26"
           fx:controller="seda_project.control_alt_defeat.gamebox.Memory.Controller.GameScreen">
    <VBox alignment="TOP_CENTER">
        <fx:include source="../TopBar.fxml"/>

        <HexVBox fx:id="header" alignment="TOP_CENTER" fillWidth="false" maxHeight="-Infinity" maxWidth="-Infinity"
                 styleClass="box">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
            <Label alignment="CENTER" contentDisplay="CENTER" maxHeight="-Infinity" maxWidth="-Infinity"
                   styleClass="headerText" text="Memory" textAlignment="CENTER" textOverrun="CLIP">
                <font>
                    <Font name="Arial Bold" size="24.0"/>
                </font>
                <VBox.margin>
                    <Insets/>
                </VBox.margin>
            </Label>
            <VBox.margin>
                <Insets top="10.0"/>
            </VBox.margin>
        </HexVBox>

        <AnchorPane prefHeight="100.0" prefWidth="800.0">
            <HBox alignment="CENTER" layoutX="152.0" layoutY="12.0" spacing="20.0" AnchorPane.rightAnchor="30.0">
                <HexHBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="box">
                    <Label styleClass="normalText" text="Current Turn: ">
                        <padding>
                            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                        </padding>
                    </Label>
                    <Label fx:id="activePlayerLabel" styleClass="normalText">
                        <padding>
                            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                        </padding>
                    </Label>
                </HexHBox>
                <VBox alignment="CENTER" spacing="7.0">
                    <HexHBox spacing="8.0">
                        <styleClass>
                            <String fx:value="ready"/>
                        </styleClass>
                        <padding>
                            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                        </padding>
                        <Label fx:id="sboardP1" text="Player 1: "/>
                        <Label fx:id="sboardScoreP1" minWidth="50.0" text="0"/>
                    </HexHBox>
                    <HexHBox spacing="8.0">
                        <styleClass>
                            <String fx:value="error"/>
                        </styleClass>
                        <padding>
                            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                        </padding>
                        <Label fx:id="sboardP2" text="Player 2: "/>
                        <Label fx:id="sboardScoreP2" minWidth="50.0" text="0"/>
                    </HexHBox>
                </VBox>
            </HBox>

            <StackPane alignment="CENTER_LEFT" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="button-wrapper"
                       AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="36.0">
                <HexButton onAction="#onExitGameAction" text="Exit Game"/>
            </StackPane>

            <VBox.margin>
                <Insets/>
            </VBox.margin>
        </AnchorPane>

        <StackPane fx:id="gamePane" minHeight="400.0" prefHeight="400.0" VBox.vgrow="ALWAYS"/>
    </VBox>
    <stylesheets>
        <URL value="@../../css/stylesheets/fontstyle.css"/>
        <URL value="@../../css/stylesheets/MainTheme.css"/>
        <URL value="@../../css/stylesheets/MenuStyle.css"/>
        <URL value="@../../css/stylesheets/MemoryMenu.css"/>
    </stylesheets>
</StackPane>
