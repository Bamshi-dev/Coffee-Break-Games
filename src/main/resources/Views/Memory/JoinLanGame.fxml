<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import seda_project.control_alt_defeat.gamebox.ui.*?>
<?import java.net.URL?>
<StackPane xmlns:fx="http://javafx.com/fxml/1" fx:id="root" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="600.0"
           minWidth="800.0" styleClass="background" xmlns="http://javafx.com/javafx/26"
           fx:controller="seda_project.control_alt_defeat.gamebox.Memory.Controller.JoinLan">
    <VBox alignment="TOP_CENTER">
        <fx:include source="../TopBar.fxml"/>
        <HexVBox fx:id="header" alignment="TOP_CENTER" fillWidth="false" maxHeight="-Infinity" maxWidth="-Infinity"
                 styleClass="box">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
            <Label alignment="CENTER" contentDisplay="CENTER" maxHeight="-Infinity" maxWidth="-Infinity"
                   styleClass="headerText" text="Memory" textAlignment="CENTER" textOverrun="CLIP">
                <font>
                    <Font name="Arial Bold" size="24.0"/>
                </font>
            </Label>
            <Label alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="normalText"
                   text="Join a Game">
                <font>
                    <Font size="18.0"/>
                </font>
            </Label>
            <VBox.margin>
                <Insets top="10.0"/>
            </VBox.margin>
        </HexVBox>

        <StackPane prefHeight="465.0" VBox.vgrow="ALWAYS">
            <HexVBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="box">
                <GridPane hgap="5.0" maxHeight="-Infinity" maxWidth="-Infinity" vgap="5.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="-Infinity"/>
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="-Infinity"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints maxHeight="-Infinity" vgrow="SOMETIMES"/>
                        <RowConstraints maxHeight="-Infinity" vgrow="SOMETIMES"/>
                    </rowConstraints>
                    <Label alignment="CENTER" text="Your Name"/>
                    <Label text="Host IP:" GridPane.rowIndex="1"/>
                    <TextField fx:id="ipAdresseTF" maxHeight="-Infinity" maxWidth="-Infinity"
                               promptText="Insert Host IP-Adress" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <GridPane.margin>
                            <Insets right="5.0"/>
                        </GridPane.margin>
                    </TextField>
                    <TextField fx:id="joinPlayerNameTF" maxHeight="-Infinity" maxWidth="-Infinity"
                               promptText="Insert Player 1 Name " GridPane.columnIndex="1">
                        <GridPane.margin>
                            <Insets right="5.0"/>
                        </GridPane.margin>
                    </TextField>
                    <padding>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                    </padding>
                </GridPane>
                <HexLabel fx:id="joinStatus" maxWidth="250.0" styleClass="error" wrapText="true"/>

                <HBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity">
                    <StackPane maxHeight="-Infinity" maxWidth="-Infinity" styleClass="button-wrapper"
                               GridPane.columnSpan="2" GridPane.halignment="RIGHT" GridPane.rowIndex="3">
                        <HexButton onAction="#onBackAction" text="Back"/>
                    </StackPane>
                    <StackPane maxHeight="-Infinity" maxWidth="-Infinity" styleClass="button-wrapper"
                               GridPane.columnIndex="3" GridPane.rowIndex="3">
                        <HexButton onAction="#onConnectAction" text="Connect"/>
                    </StackPane>
                </HBox>
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                </padding>
            </HexVBox>
        </StackPane>
    </VBox>
    <stylesheets>
        <URL value="@../../css/stylesheets/fontstyle.css"/>
        <URL value="@../../css/stylesheets/MainTheme.css"/>
        <URL value="@../../css/stylesheets/MenuStyle.css"/>
        <URL value="@../../css/stylesheets/MemoryMenu.css"/>
    </stylesheets>
</StackPane>
