<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import seda_project.control_alt_defeat.gamebox.ui.*?>
<?import java.net.URL?>
<StackPane xmlns:fx="http://javafx.com/fxml/1" fx:id="root" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="600.0"
           minWidth="800.0" styleClass="background" xmlns="http://javafx.com/javafx/26"
           fx:controller="seda_project.control_alt_defeat.gamebox.Memory.Controller.MemoryMenu">
    <VBox alignment="TOP_CENTER">
        <fx:include source="../TopBar.fxml"/>

        <HexVBox fx:id="header" alignment="TOP_CENTER" fillWidth="false" maxHeight="-Infinity" maxWidth="-Infinity"
                 styleClass="box">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
            <Label alignment="CENTER" contentDisplay="CENTER" maxHeight="-Infinity" maxWidth="-Infinity"
                   styleClass="headerText" text="Memory" textAlignment="CENTER" textOverrun="CLIP">
                <font>
                    <Font name="Arial Bold" size="24.0"/>
                </font>
            </Label>
            <Label alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="normalText"
                   text="Main Menu">
                <font>
                    <Font size="18.0"/>
                </font>
                <VBox.margin>
                    <Insets/>
                </VBox.margin>
            </Label>
            <VBox.margin>
                <Insets top="10.0"/>
            </VBox.margin>
        </HexVBox>

        <StackPane prefHeight="485.0" VBox.vgrow="ALWAYS">
            <HexVBox maxHeight="-Infinity" maxWidth="-Infinity" styleClass="box">
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                </padding>
                <Label maxHeight="-Infinity" maxWidth="-Infinity" text="Local Game">
                    <font>
                        <Font size="18.0"/>
                    </font>
                </Label>
                <VBox>
                    <padding>
                        <Insets bottom="10.0" left="40.0"/>
                    </padding>
                    <StackPane alignment="CENTER_LEFT" maxHeight="-Infinity" maxWidth="-Infinity"
                               styleClass="button-wrapper">
                        <HexButton onAction="#onLocalAction" text="Local Game"/>
                    </StackPane>
                </VBox>
                <Label maxHeight="-Infinity" maxWidth="-Infinity" text="LAN Game">
                    <font>
                        <Font size="18.0"/>
                    </font>
                </Label>
                <VBox>
                    <padding>
                        <Insets bottom="15.0" left="40.0"/>
                    </padding>
                    <StackPane alignment="CENTER_LEFT" maxHeight="-Infinity" maxWidth="-Infinity"
                               styleClass="button-wrapper">
                        <HexButton onAction="#onHostAction" text="Host Game"/>
                    </StackPane>
                    <StackPane alignment="CENTER_LEFT" maxHeight="-Infinity" maxWidth="-Infinity"
                               styleClass="button-wrapper">
                        <HexButton onAction="#onJoinAction" text="Join Game"/>
                    </StackPane>
                </VBox>
                <VBox>
                    <padding>
                        <Insets left="40.0"/>
                    </padding>
                    <StackPane alignment="CENTER_LEFT" maxHeight="-Infinity" maxWidth="-Infinity"
                               styleClass="button-wrapper">
                        <HexButton onAction="#onExitAction" text="Back"/>
                    </StackPane>
                </VBox>
            </HexVBox>
        </StackPane>
    </VBox>
    <stylesheets>
        <URL value="@../../css/stylesheets/fontstyle.css"/>
        <URL value="@../../css/stylesheets/MainTheme.css"/>
        <URL value="@../../css/stylesheets/MenuStyle.css"/>
        <URL value="@../../css/stylesheets/MemoryMenu.css"/>
    </stylesheets>
</StackPane>
