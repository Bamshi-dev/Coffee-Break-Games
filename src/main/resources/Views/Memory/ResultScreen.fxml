<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import seda_project.control_alt_defeat.gamebox.ui.HexButton?>
<?import seda_project.control_alt_defeat.gamebox.ui.HexVBox?>
<?import java.net.URL?>
<StackPane xmlns:fx="http://javafx.com/fxml/1" fx:id="root" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="600.0"
           minWidth="800.0" styleClass="background" xmlns="http://javafx.com/javafx/26"
           fx:controller="seda_project.control_alt_defeat.gamebox.Memory.Controller.ResultScreen">
    <VBox alignment="TOP_CENTER">
        <fx:include source="../TopBar.fxml"/>
        <HexVBox fx:id="header" alignment="TOP_CENTER" fillWidth="false" maxHeight="-Infinity" maxWidth="-Infinity"
                 styleClass="box">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
            <Label alignment="CENTER" contentDisplay="CENTER" maxHeight="-Infinity" maxWidth="-Infinity"
                   styleClass="headerText" text="Memory" textAlignment="CENTER" textOverrun="CLIP">
                <font>
                    <Font name="Arial Bold" size="24.0"/>
                </font>
            </Label>
            <Label alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="normalText"
                   text="Game Result">
                <font>
                    <Font size="18.0"/>
                </font>
            </Label>
            <VBox.margin>
                <Insets top="10.0"/>
            </VBox.margin>
        </HexVBox>


        <StackPane prefHeight="465.0" VBox.vgrow="ALWAYS">
            <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" spacing="10.0" styleClass="box">
                <Label styleClass="normalText" text="Game Result" VBox.vgrow="ALWAYS"/>
                <GridPane hgap="5.0" maxHeight="-Infinity" maxWidth="-Infinity" vgap="5.0" VBox.vgrow="ALWAYS">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="-Infinity"/>
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="-Infinity"/>
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="-Infinity"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints maxHeight="-Infinity" vgrow="SOMETIMES"/>
                        <RowConstraints maxHeight="-Infinity" vgrow="SOMETIMES"/>
                        <RowConstraints maxHeight="-Infinity" vgrow="SOMETIMES"/>
                        <RowConstraints maxHeight="-Infinity" vgrow="SOMETIMES"/>
                    </rowConstraints>
                    <Label fx:id="positionLooserLabel" maxHeight="-Infinity" maxWidth="-Infinity" text="Loser"
                           GridPane.rowIndex="1"/>
                    <Label fx:id="looserLabel" alignment="CENTER" contentDisplay="CENTER" maxHeight="-Infinity"
                           maxWidth="-Infinity" textAlignment="CENTER" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    <Label maxHeight="-Infinity" maxWidth="-Infinity" text="Deck Size" GridPane.rowIndex="2"/>
                    <Label fx:id="deckSizeLabel" alignment="CENTER" contentDisplay="CENTER" maxHeight="-Infinity"
                           maxWidth="-Infinity" textAlignment="CENTER" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    <Label maxHeight="-Infinity" maxWidth="-Infinity" text="Match Size" GridPane.rowIndex="3"/>
                    <Label fx:id="matchSizeLabel" alignment="CENTER" contentDisplay="CENTER" maxHeight="-Infinity"
                           maxWidth="-Infinity" textAlignment="CENTER" wrapText="true" GridPane.columnIndex="1"
                           GridPane.rowIndex="3">
                        <padding>
                            <Insets left="5.0" right="5.0"/>
                        </padding>
                    </Label>
                    <Label fx:id="positionWinnerLabel" maxHeight="-Infinity" maxWidth="-Infinity" text="Winner:"/>
                    <Label fx:id="winnerLabel" alignment="CENTER" contentDisplay="CENTER" maxHeight="-Infinity"
                           maxWidth="-Infinity" textAlignment="CENTER" GridPane.columnIndex="1"/>
                    <Label fx:id="winnerPointsLabel" maxHeight="-Infinity" maxWidth="-Infinity"
                           GridPane.columnIndex="2"/>
                    <Label fx:id="looserPointsLabel" maxHeight="-Infinity" maxWidth="-Infinity" GridPane.columnIndex="2"
                           GridPane.rowIndex="1"/>
                    <padding>
                        <Insets left="15.0" right="15.0"/>
                    </padding>
                </GridPane>

                <HBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" VBox.vgrow="ALWAYS">
                    <StackPane maxHeight="-Infinity" maxWidth="-Infinity" styleClass="button-wrapper">
                        <HexButton onAction="#onExitGameAction" text="Exit"/>
                    </StackPane>
                    <StackPane maxHeight="-Infinity" maxWidth="-Infinity" styleClass="button-wrapper">
                        <HexButton fx:id="playAgainButton" onAction="#onPlayAgainAction" text="Play Again"/>
                    </StackPane>
                </HBox>
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                </padding>
            </VBox>
        </StackPane>
    </VBox>
    <stylesheets>
        <URL value="@../../css/stylesheets/fontstyle.css"/>
        <URL value="@../../css/stylesheets/MainTheme.css"/>
        <URL value="@../../css/stylesheets/MenuStyle.css"/>
        <URL value="@../../css/stylesheets/MemoryMenu.css"/>
    </stylesheets>
</StackPane>
