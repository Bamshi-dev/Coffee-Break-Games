<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import seda_project.control_alt_defeat.gamebox.ui.HexButton?>
<?import seda_project.control_alt_defeat.gamebox.ui.HexVBox?>

<StackPane fx:id="root" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="600.0" minWidth="800.0" styleClass="background" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="seda_project.control_alt_defeat.gamebox.ui.StartingScreenController">
    <stylesheets>
        <URL value="@../css/stylesheets/fontstyle.css" />
        <URL value="@../css/stylesheets/MainMenu.css" />
        <URL value="@../css/stylesheets/MainTheme.css" />
        <URL value="@../css/stylesheets/MenuStyle.css" />
    </stylesheets>
    <VBox alignment="TOP_CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308">
        <fx:include source="TopBar.fxml" />
        <HexVBox fx:id="header" alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="box">
            <VBox.margin>
                <Insets top="10.0" />
            </VBox.margin>
            <Label alignment="CENTER" contentDisplay="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="headerText" text="Main Menu" textAlignment="CENTER" textOverrun="CLIP">
                <font>
                    <Font name="Arial Bold" size="24.0" />
                </font>
            </Label>
        </HexVBox>


        <StackPane maxHeight="1.7976931348623157E308" prefHeight="485.0" VBox.vgrow="ALWAYS">
            <VBox maxHeight="-Infinity" maxWidth="-Infinity" spacing="5.0" styleClass="box">
                <Label maxHeight="-Infinity" maxWidth="-Infinity" styleClass="normalText" text="Memory">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Label>
                <VBox>
                    <padding>
                        <Insets bottom="10.0" left="40.0" />
                    </padding>
                    <StackPane alignment="CENTER_LEFT" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="button-wrapper">
                        <HexButton onAction="#onMemoryAction" text="Play Memory" />
                    </StackPane>
                </VBox>
                <Label styleClass="normalText" text="Tetris">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Label>
                <VBox>
                    <padding>
                        <Insets bottom="10.0" left="40.0" />
                    </padding>
                    <StackPane alignment="CENTER_LEFT" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="button-wrapper">
                        <HexButton onAction="#onTetrisAction" text="Play Tetris" />
                    </StackPane>
                </VBox>
                <Label styleClass="normalText" text="Hex Chess" />
                <VBox>
                    <padding>
                        <Insets bottom="15.0" left="40.0" />
                    </padding>
                    <StackPane alignment="CENTER_LEFT" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="button-wrapper">
                        <HexButton onAction="#onHexChessAction" text="Play Hex Chess" />
                    </StackPane>
                </VBox>
                <VBox alignment="CENTER_LEFT">
                    <StackPane alignment="CENTER_LEFT" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="button-wrapper">
                        <HexButton onAction="#onExitAction" text="Exit" />
                  <opaqueInsets>
                     <Insets />
                  </opaqueInsets>
                  <VBox.margin>
                     <Insets left="40.0" />
                  </VBox.margin>
                    </StackPane>
                </VBox>
            <padding>
               <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            </VBox>
        </StackPane>
    </VBox>
</StackPane>
