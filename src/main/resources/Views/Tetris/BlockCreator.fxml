<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import seda_project.control_alt_defeat.gamebox.ui.*?>
<?import java.net.URL?>

<StackPane xmlns:fx="http://javafx.com/fxml/1" fx:id="root" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="600.0"
           minWidth="800.0" styleClass="background" xmlns="http://javafx.com/javafx/26"
           fx:controller="seda_project.control_alt_defeat.gamebox.Tetris.Controller.BlockController">
    <stylesheets>
        <URL value="@../../css/stylesheets/fontstyle.css"/>
        <URL value="@../../css/stylesheets/MainTheme.css"/>
        <URL value="@../../css/stylesheets/MenuStyle.css"/>
        <URL value="@../../css/stylesheets/TetrisMenu.css"/>
    </stylesheets>
    <VBox alignment="TOP_CENTER">
        <fx:include source="../TopBar.fxml"/>
        <HexVBox fx:id="header" alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="box">
            <VBox.margin>
                <Insets top="10.0"/>
            </VBox.margin>
            <Label alignment="CENTER" contentDisplay="CENTER" maxHeight="-Infinity" maxWidth="-Infinity"
                   styleClass="headerText" text="Tetris" textAlignment="CENTER" textOverrun="CLIP">
                <font>
                    <Font name="Arial Bold" size="24.0"/>
                </font>
            </Label>
            <Label alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="normalText"
                   text="Block Creator">
                <font>
                    <Font size="18.0"/>
                </font>
            </Label>
        </HexVBox>

        <StackPane prefHeight="465.0" VBox.vgrow="ALWAYS">
            <VBox.margin>
                <Insets top="10.0"/>
            </VBox.margin>
            <HexHBox maxWidth="-Infinity" styleClass="box">
                <StackPane.margin>
                    <Insets bottom="10.0"/>
                </StackPane.margin>
                <SplitPane dividerPositions="0.5" maxHeight="400.0" maxWidth="700.0"
                           style="-fx-background-color: transparent;">
                    <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
                    </padding>
                    <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity">
                        <ScrollPane fx:id="scrollPane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="350.0"
                                    minWidth="200.0" styleClass="scroller"/>
                        <HBox alignment="CENTER" spacing="5.0">
                            <VBox.margin>
                                <Insets top="10.0"/>
                            </VBox.margin>
                            <StackPane styleClass="button-wrapper">
                                <HexButton maxHeight="-Infinity" maxWidth="-Infinity" onAction="#onLoadAction"
                                           text="Load"/>
                            </StackPane>
                            <StackPane prefHeight="46.0" prefWidth="124.0" styleClass="button-wrapper">
                                <HexButton maxHeight="-Infinity" maxWidth="-Infinity" onAction="#onDeleteAction"
                                           text="Delete"/>
                            </StackPane>
                        </HBox>
                    </VBox>
                    <VBox alignment="CENTER" fillWidth="false" spacing="5.0">
                        <HBox alignment="CENTER" spacing="3.0">
                            <VBox.margin>
                                <Insets bottom="10.0"/>
                            </VBox.margin>
                            <Label maxHeight="-Infinity" maxWidth="-Infinity" text="Block Color: "/>
                            <ColorPicker fx:id="colorPicker" maxHeight="-Infinity" maxWidth="-Infinity"
                                         onAction="#onColorAction" promptText="Block Color"/>
                        </HBox>
                        <GridPane fx:id="gridPane" alignment="CENTER" gridLinesVisible="true" maxHeight="300.0"
                                  maxWidth="300.0" minHeight="300.0" minWidth="300.0" prefHeight="300.0"
                                  prefWidth="300.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="NEVER" maxWidth="75.0" minWidth="75.0" prefWidth="75.00"/>
                                <ColumnConstraints hgrow="NEVER" maxWidth="75.0" minWidth="75.0" prefWidth="75.00"/>
                                <ColumnConstraints hgrow="NEVER" maxWidth="75.0" minWidth="75.0" prefWidth="75.00"/>
                                <ColumnConstraints hgrow="NEVER" maxWidth="75.0" minWidth="75.0" prefWidth="75.00"/>
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints maxHeight="75.0" minHeight="75.0" prefHeight="75.0" vgrow="NEVER"/>
                                <RowConstraints maxHeight="75.0" minHeight="75.0" prefHeight="75.0" vgrow="NEVER"/>
                                <RowConstraints maxHeight="75.0" minHeight="75.0" prefHeight="75.0" vgrow="NEVER"/>
                                <RowConstraints maxHeight="75.0" minHeight="75.0" prefHeight="75.0" vgrow="NEVER"/>
                            </rowConstraints>
                        </GridPane>
                        <HBox alignment="CENTER">
                            <StackPane styleClass="button-wrapper">
                                <HexButton onAction="#onResetAction" text="Reset"/>
                            </StackPane>
                            <StackPane styleClass="button-wrapper">
                                <HexButton onAction="#onBackAction" text="Back"/>
                            </StackPane>
                            <StackPane styleClass="button-wrapper">
                                <HexButton fx:id="saveButton" onAction="#onSaveAction" text="Save"/>
                            </StackPane>
                        </HBox>
                    </VBox>
                </SplitPane>
            </HexHBox>
        </StackPane>
    </VBox>
</StackPane>
