<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import seda_project.control_alt_defeat.gamebox.ui.HexButton?>
<?import seda_project.control_alt_defeat.gamebox.ui.ToggleSwitch?>
<?import java.lang.String?>
<?import java.net.URL?>

<?import seda_project.control_alt_defeat.gamebox.ui.HexVBox?>
<StackPane xmlns:fx="http://javafx.com/fxml/1" fx:id="root" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="600.0"
           minWidth="800.0" styleClass="background" xmlns="http://javafx.com/javafx/26"
           fx:controller="seda_project.control_alt_defeat.gamebox.Tetris.Controller.HostLan">
    <stylesheets>
        <URL value="@../../css/stylesheets/fontstyle.css"/>
        <URL value="@../../css/stylesheets/MainTheme.css"/>
        <URL value="@../../css/stylesheets/MenuStyle.css"/>
        <URL value="@../../css/stylesheets/TetrisMenu.css"/>
    </stylesheets>

    <VBox alignment="TOP_CENTER">
        <fx:include source="../TopBar.fxml"/>

        <HexVBox fx:id="header" alignment="TOP_CENTER" fillWidth="false" maxHeight="-Infinity" maxWidth="-Infinity"
                 styleClass="box">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
            <Label alignment="CENTER" contentDisplay="CENTER" maxHeight="-Infinity" maxWidth="-Infinity"
                   styleClass="headerText" text="Tetris" textAlignment="CENTER" textOverrun="CLIP">
            </Label>
            <Label alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="normalText"
                   text="Host Configuration">
                <font>
                    <Font size="18.0"/>
                </font>
            </Label>
            <VBox.margin>
                <Insets top="10.0"/>
            </VBox.margin>
        </HexVBox>

        <StackPane prefHeight="516.0" prefWidth="808.0" VBox.vgrow="ALWAYS">
            <HexVBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="box">
                <GridPane alignment="CENTER" hgap="5.0" maxHeight="-Infinity" maxWidth="-Infinity" vgap="5.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="109.0" minWidth="10.0" prefWidth="109.0"/>
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="94.0" minWidth="10.0"
                                           prefWidth="58.599999999999994"/>
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="185.0" minWidth="10.0"
                                           prefWidth="71.80000000000001"/>
                        <ColumnConstraints/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints maxHeight="-Infinity" minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                        <RowConstraints maxHeight="-Infinity" minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                        <RowConstraints maxHeight="30.0" minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                    </rowConstraints>
                    <Label alignment="CENTER" text="Your Name:"/>
                    <TextField fx:id="hostNameTF" prefHeight="26.0" prefWidth="220.0" promptText="Insert Player 1 Name "
                               GridPane.columnIndex="1" GridPane.columnSpan="3">
                        <GridPane.margin>
                            <Insets right="5.0"/>
                        </GridPane.margin>
                    </TextField>
                    <Label text="Your Level:" GridPane.rowIndex="1"/>
                    <ComboBox fx:id="yourLevel" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="Hard Mode:" GridPane.rowIndex="2"/>
                    <ToggleSwitch fx:id="toggleSwitch" maxHeight="-Infinity" maxWidth="-Infinity"
                                  GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    <opaqueInsets>
                        <Insets/>
                    </opaqueInsets>
                </GridPane>
                <StackPane maxHeight="-Infinity" maxWidth="-Infinity" styleClass="button-wrapper">
                    <HexButton onAction="#onAdvancedSettingsAction" text="Advanced Settings"/>
                    <VBox.margin>
                        <Insets top="10.0"/>
                    </VBox.margin>
                </StackPane>
                <Label fx:id="statusLabel" alignment="CENTER" maxWidth="300.0" textAlignment="CENTER" visible="false"
                       wrapText="true">
                    <styleClass>
                        <String fx:value="error"/>
                        <String fx:value="box"/>
                    </styleClass>
                    <padding>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                    </padding>
                    <VBox.margin>
                        <Insets top="10.0"/>
                    </VBox.margin>
                </Label>
                <HBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity">
                    <VBox.margin>
                        <Insets bottom="10.0" top="10.0"/>
                    </VBox.margin>
                    <StackPane styleClass="button-wrapper">
                        <HexButton onAction="#onBackAction" text="Back"/>
                    </StackPane>
                    <StackPane styleClass="button-wrapper">
                        <HexButton onAction="#onSearchAction" text="Search"/>
                    </StackPane>
                </HBox>
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                </padding>
            </HexVBox>
        </StackPane>
    </VBox>
</StackPane>
