<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import seda_project.control_alt_defeat.gamebox.ui.*?>
<?import java.net.URL?>

<StackPane xmlns:fx="http://javafx.com/fxml/1" fx:id="root" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="600.0"
           minWidth="800.0" styleClass="background" xmlns="http://javafx.com/javafx/26"
           fx:controller="seda_project.control_alt_defeat.gamebox.Tetris.Controller.JoinLan">
    <stylesheets>
        <URL value="@../../css/stylesheets/fontstyle.css"/>
        <URL value="@../../css/stylesheets/MainTheme.css"/>
        <URL value="@../../css/stylesheets/MenuStyle.css"/>
        <URL value="@../../css/stylesheets/TetrisMenu.css"/>
    </stylesheets>
    <VBox alignment="TOP_CENTER">
        <fx:include source="../TopBar.fxml"/>

        <HexVBox fx:id="header" alignment="TOP_CENTER" fillWidth="false" maxHeight="-Infinity" maxWidth="-Infinity"
                 styleClass="box">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
            <Label alignment="CENTER" contentDisplay="CENTER" maxHeight="-Infinity" maxWidth="-Infinity"
                   styleClass="headerText" text="Tetris" textAlignment="CENTER" textOverrun="CLIP">
            </Label>
            <Label alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="normalText"
                   text="Join a Game">
                <font>
                    <Font size="18.0"/>
                </font>
            </Label>
            <VBox.margin>
                <Insets top="10.0"/>
            </VBox.margin>
        </HexVBox>

        <StackPane prefHeight="475.0" VBox.vgrow="ALWAYS">
            <padding>
                <Insets top="5.0"/>
            </padding>
            <HexVBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="box">
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                </padding>
                <GridPane hgap="5.0" vgap="5.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="-Infinity"/>
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="-Infinity"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints maxHeight="-Infinity" vgrow="SOMETIMES"/>
                        <RowConstraints maxHeight="-Infinity" vgrow="SOMETIMES"/>
                    </rowConstraints>
                    <Label alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" text="Your Name:"/>
                    <TextField fx:id="joinPlayerNameTF" maxHeight="-Infinity" maxWidth="-Infinity"
                               promptText="Insert Player 1 Name " GridPane.columnIndex="1"/>
                    <Label text="Your Level:" GridPane.rowIndex="1"/>
                    <ComboBox fx:id="yourLevel" maxHeight="-Infinity" maxWidth="-Infinity" GridPane.columnIndex="1"
                              GridPane.rowIndex="1"/>
                </GridPane>
                <ScrollPane fx:id="scrollPane" fitToWidth="true" maxHeight="-Infinity" maxWidth="-Infinity"
                            styleClass="transparent-scroll">
                    <VBox fx:id="scrollElements" maxHeight="-Infinity" maxWidth="-Infinity"
                          styleClass="transparent-scroll-content"/>
                </ScrollPane>
                <HexLabel fx:id="joinStatus" maxWidth="220.0" styleClass="error" wrapText="true"/>
                <HBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity">
                    <StackPane styleClass="button-wrapper">
                        <HexButton onAction="#onBackAction" text="Back"/>
                    </StackPane>
                    <StackPane styleClass="button-wrapper">
                        <HexButton onAction="#onConnectAction" text="Connect"/>
                    </StackPane>
                </HBox>
            </HexVBox>
        </StackPane>
    </VBox>
</StackPane>
