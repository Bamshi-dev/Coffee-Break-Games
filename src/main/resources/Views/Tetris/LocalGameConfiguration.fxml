<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import seda_project.control_alt_defeat.gamebox.ui.HexButton?>
<?import seda_project.control_alt_defeat.gamebox.ui.HexVBox?>
<?import java.lang.String?>
<?import java.net.URL?>

<StackPane xmlns:fx="http://javafx.com/fxml/1" fx:id="root" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="600.0"
           minWidth="800.0" styleClass="background" xmlns="http://javafx.com/javafx/26"
           fx:controller="seda_project.control_alt_defeat.gamebox.Tetris.Controller.LocalGameConfiguration">
    <stylesheets>
        <URL value="@../../css/stylesheets/fontstyle.css"/>
        <URL value="@../../css/stylesheets/MainTheme.css"/>
        <URL value="@../../css/stylesheets/MenuStyle.css"/>
        <URL value="@../../css/stylesheets/TetrisMenu.css"/>
    </stylesheets>
    <VBox alignment="TOP_CENTER">
        <fx:include source="../TopBar.fxml"/>

        <HexVBox fx:id="header" alignment="TOP_CENTER" fillWidth="false" maxHeight="-Infinity" maxWidth="-Infinity"
                 styleClass="box">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
            <Label alignment="CENTER" contentDisplay="CENTER" maxHeight="-Infinity" maxWidth="-Infinity"
                   styleClass="headerText" text="Tetris" textAlignment="CENTER" textOverrun="CLIP">
                <font>
                    <Font name="Arial Bold" size="24.0"/>
                </font>
            </Label>
            <Label alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="normalText"
                   text="Local Game Configuration">
                <font>
                    <Font size="18.0"/>
                </font>
            </Label>
            <VBox.margin>
                <Insets top="10.0"/>
            </VBox.margin>
        </HexVBox>

        <StackPane prefHeight="465.0" VBox.vgrow="ALWAYS">
            <HexVBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="box">
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                </padding>
                <Label styleClass="normalText" text="Player 1">
                    <VBox.margin>
                        <Insets top="10.0"/>
                    </VBox.margin>
                </Label>
                <GridPane vgap="5.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="-Infinity"/>
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="-Infinity"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints maxHeight="-Infinity" vgrow="SOMETIMES"/>
                        <RowConstraints maxHeight="-Infinity" vgrow="SOMETIMES"/>
                    </rowConstraints>
                    <Label maxHeight="-Infinity" maxWidth="-Infinity" text="Player 1 Name:"/>
                    <TextField fx:id="player1TF" maxHeight="-Infinity" maxWidth="-Infinity"
                               promptText="Insert Player 1 Name " GridPane.columnIndex="1">
                        <GridPane.margin>
                            <Insets right="5.0"/>
                        </GridPane.margin>
                    </TextField>
                    <Label maxHeight="-Infinity" maxWidth="-Infinity" text="Player 1 Level:" GridPane.rowIndex="1"/>
                    <ComboBox fx:id="player1Level" maxHeight="-Infinity" maxWidth="-Infinity" visibleRowCount="7"
                              GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                </GridPane>
                <Label styleClass="normalText" text="Player 2">
                    <VBox.margin>
                        <Insets top="10.0"/>
                    </VBox.margin>
                </Label>
                <GridPane vgap="5.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="-Infinity"/>
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="-Infinity"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints maxHeight="-Infinity" vgrow="SOMETIMES"/>
                        <RowConstraints maxHeight="-Infinity" vgrow="SOMETIMES"/>
                    </rowConstraints>
                    <Label maxHeight="-Infinity" maxWidth="-Infinity" text="Player 2 Name:"/>
                    <Label maxHeight="-Infinity" maxWidth="-Infinity" text="Player 2 Level:" GridPane.rowIndex="1"/>
                    <TextField fx:id="player2TF" maxHeight="-Infinity" maxWidth="-Infinity"
                               promptText="Insert Player 2 Name" GridPane.columnIndex="1"/>
                    <ComboBox fx:id="player2Level" maxHeight="-Infinity" maxWidth="-Infinity" visibleRowCount="7"
                              GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                </GridPane>
                <StackPane maxHeight="-Infinity" maxWidth="-Infinity" styleClass="button-wrapper">
                    <HexButton onAction="#onAdvancedSettingsAction" text="Advanced Settings"/>
                    <VBox.margin>
                        <Insets top="10.0"/>
                    </VBox.margin>
                </StackPane>
                <Label fx:id="statusLabel" maxHeight="-Infinity" maxWidth="270.0" wrapText="true">
                    <VBox.margin>
                        <Insets bottom="10.0" top="10.0"/>
                    </VBox.margin>
                    <styleClass>
                        <String fx:value="box"/>
                        <String fx:value="error"/>
                    </styleClass>
                    <padding>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                    </padding>
                </Label>
                <HBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity">
                    <VBox.margin>
                        <Insets bottom="10.0"/>
                    </VBox.margin>
                    <StackPane maxHeight="-Infinity" maxWidth="-Infinity" styleClass="button-wrapper">
                        <HexButton onAction="#onBackAction" text="Back"/>
                    </StackPane>
                    <StackPane maxHeight="-Infinity" maxWidth="-Infinity" styleClass="button-wrapper">
                        <HexButton onAction="#onStartAction" text="Start Game"/>
                    </StackPane>
                </HBox>
            </HexVBox>
        </StackPane>
    </VBox>
</StackPane>
