<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import seda_project.control_alt_defeat.gamebox.ui.HexButton?>
<?import seda_project.control_alt_defeat.gamebox.ui.HexVBox?>

<StackPane fx:id="root" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="600.0" minWidth="800.0" styleClass="background" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="seda_project.control_alt_defeat.gamebox.Tetris.Controller.TetrisMenu">
    <stylesheets>
        <URL value="@../../css/stylesheets/fontstyle.css" />
        <URL value="@../../css/stylesheets/MainTheme.css" />
        <URL value="@../../css/stylesheets/MenuStyle.css" />
        <URL value="@../../css/stylesheets/TetrisMenu.css" />
    </stylesheets>
    <VBox alignment="TOP_CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308">
        <fx:include source="../TopBar.fxml" />
        <HexVBox fx:id="header" alignment="TOP_CENTER" fillWidth="false" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="box">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <Label alignment="CENTER" contentDisplay="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="headerText" text="Tetris" textAlignment="CENTER" textOverrun="CLIP">
                <font>
                    <Font name="Arial Bold" size="24.0" />
                </font>
            </Label>
            <Label styleClass="normalText" text="Main Menu" />
            <VBox.margin>
                <Insets top="10.0" />
            </VBox.margin>
        </HexVBox>

        <StackPane prefHeight="475.0" VBox.vgrow="ALWAYS">
            <VBox alignment="CENTER_LEFT" maxHeight="-Infinity" maxWidth="-Infinity" spacing="5.0" styleClass="box">
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                </padding>
                <Label maxHeight="-Infinity" maxWidth="-Infinity" text="Local Game">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Label>
                <VBox alignment="CENTER_LEFT">
                    <VBox.margin>
                        <Insets bottom="10.0" left="40.0" />
                    </VBox.margin>
                    <StackPane alignment="CENTER_LEFT" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="button-wrapper">
                        <HexButton onAction="#onLocalAction" text="Start Local Game" />
                    </StackPane>

                </VBox>
                <Label maxHeight="-Infinity" maxWidth="-Infinity" text="LAN Game">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Label>
                <VBox alignment="CENTER_LEFT">
                    <VBox.margin>
                        <Insets bottom="10.0" left="40.0" />
                    </VBox.margin>
                    <StackPane alignment="CENTER_LEFT" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="button-wrapper">
                        <HexButton onAction="#onHostAction" text="Host Game" />
                    </StackPane>
                    <StackPane alignment="CENTER_RIGHT" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="button-wrapper">
                        <HexButton onAction="#onJoinAction" text="Join Game" />
                    </StackPane>
                </VBox>
                <Label maxHeight="-Infinity" maxWidth="-Infinity" text="Others">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Label>
                <VBox alignment="CENTER_LEFT">
                    <VBox.margin>
                        <Insets left="40.0" />
                    </VBox.margin>
                    <StackPane alignment="CENTER_LEFT" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="button-wrapper">
                        <HexButton onAction="#onPartDesignerAciton" text="Block Designer" />
                    </StackPane>
                    <StackPane alignment="CENTER_LEFT" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="button-wrapper">
                        <HexButton onAction="#onSettingsAction" text="Key Settings" />
                    </StackPane>
                </VBox>
                <VBox alignment="CENTER_LEFT">
                    <VBox.margin>
                        <Insets left="40.0" />
                    </VBox.margin>
                    <StackPane maxHeight="-Infinity" maxWidth="-Infinity" styleClass="button-wrapper">
                        <HexButton onAction="#onExitAction" text="Back">
                            <StackPane.margin>
                                <Insets top="20.0" />
                            </StackPane.margin>
                        </HexButton>
                    </StackPane>
                </VBox>
            </VBox>
        </StackPane>
    </VBox>
</StackPane>
